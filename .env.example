# Required. Your RPC endpoint, key included. Never commit the real .env (it is gitignored).
SOLANA_RPC_URL=https://your-provider.example/your-key

# Optional. How far back the backfill lane walks on first start, as <N>d (days before the tail's
# start slot), a YYYY-MM-DD date, or a slot number. Only read by compose.yaml.
BACKFILL_UNTIL=90d
